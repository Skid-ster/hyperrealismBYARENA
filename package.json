{
  "name": "hyperrealism-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first resource-pack studio powered by the HyperRealism Rust CPU engine",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "tsx scripts/dev.ts --web-only",
    "build:web": "tsc --noEmit && vite build",
    "build:core": "cargo build --locked --release",
    "build": "npm run build:web && npm run build:core",
    "start": "tsx server/index.ts --production",
    "preview:assets": "tsx scripts/generate-previews.ts",
    "test": "vitest run",
    "test:core": "cargo test --locked",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:production": "tsx scripts/smoke-production.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.4",
    "fflate": "^0.8.3",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  }
}
